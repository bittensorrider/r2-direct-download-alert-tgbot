# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# All R2 bucket names in your account that you want to monitor (comma-separated)
R2_BUCKETS=my-clips,my-archive,my-backups

# Webhook server (runs on your Mac)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook/event
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional: ignore your own IPs on download alerts only
IGNORE_IPS=

# Optional: limit by extension (leave empty = ALL files, all types)
ALERT_EXTENSIONS=

# Toggle notification types (true/false)
NOTIFY_DOWNLOAD=true
NOTIFY_OBJECT_CREATE=true
NOTIFY_OBJECT_DELETE=true
