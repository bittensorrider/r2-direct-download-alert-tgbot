<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.r2downloadalerts.bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/REPLACE/PROJECT/PATH/.venv/bin/python</string>
    <string>-m</string>
    <string>bot</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/REPLACE/PROJECT/PATH</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/REPLACE/PROJECT/PATH/logs/bot.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/REPLACE/PROJECT/PATH/logs/bot.stderr.log</string>
</dict>
</plist>
